# ==========================================================================
# FIFARDOS — variables de entorno de PRODUCCIÓN (Dokploy)
# Copia estos valores en el panel "Environment" de Dokploy.
# NO subas secretos reales al repo.
# ==========================================================================

APP_NAME=FIFARDOS
APP_ENV=production
# Genera con:  php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://fifardos.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Ejecutar migraciones automáticamente al arrancar el contenedor ---
AUTO_MIGRATE=true

# --- Base de datos (recomendado: Postgres o MySQL) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=fifardos
DB_USERNAME=fifardos
DB_PASSWORD=cambia_esto

# --- Alternativa SQLite (usa un volumen persistente en /storage) ---
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/storage/app/database.sqlite

# --- Redis: caché, sesiones y colas en memoria (recomendado en producción) ---
# Descarga la base de datos del tráfico chateroso de los minijuegos en tiempo
# real, del throttling del MCP/agente y de las sesiones. Con docker-compose el
# host es el servicio 'redis'; con "Application" (solo Dockerfile) usa un Redis
# gestionado por Dokploy y pon aquí su host/puerto/clave.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email (para los recordatorios de torneos) ---
# En producción usa SMTP real (Mailgun, Postmark, SES, Resend, etc.)
MAIL_MAILER=smtp
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@fifardos.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Chatbot / búsqueda semántica (Gemini) ---
GEMINI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
